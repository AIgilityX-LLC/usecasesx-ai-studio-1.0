# Deployment variables and secrets — reference template
#
# Copy each entry into GitHub → Settings. Names are what the workflows read;
# values below are placeholders and must never be committed with real values.
#
#   Repository VARIABLES  (Settings → Secrets and variables → Actions → Variables)
#   Repository SECRETS    (Settings → Secrets and variables → Actions → Secrets)
#   Environment secrets   (Settings → Environments → staging | production)
#
# Environments: development (local), staging, production, preview (PRs).
# Non-secret templates also live under config/environments/*.env.example.

# ---------------------------------------------------------------- VARIABLES
# Staging — staging-deploy.yml / Environment "staging"
STAGING_SUPABASE_URL=https://your-staging-project.supabase.co
STAGING_SUPABASE_PUBLISHABLE_KEY=sb_publishable_xxxxxxxxxxxxxxxxxxxx
STAGING_SUPABASE_PROJECT_ID=your-staging-project-ref

# Preview — pr-preview.yml
PREVIEW_SUPABASE_URL=https://your-preview-project.supabase.co
PREVIEW_SUPABASE_PUBLISHABLE_KEY=sb_publishable_xxxxxxxxxxxxxxxxxxxx
PREVIEW_SUPABASE_PROJECT_ID=your-preview-project-ref

# Production — production-deploy.yml / Environment "production"
PRODUCTION_SUPABASE_URL=https://your-production-project.supabase.co
PRODUCTION_SUPABASE_PUBLISHABLE_KEY=sb_publishable_xxxxxxxxxxxxxxxxxxxx
PRODUCTION_SUPABASE_PROJECT_ID=your-production-project-ref
PRODUCTION_BASE_URL=https://your-production-domain

# CI backend suites (repository secrets — Critical gates)
# SUPABASE_URL / SUPABASE_PUBLISHABLE_KEY / SUPABASE_SERVICE_ROLE_KEY

# ------------------------------------------------------------------ SECRETS
# Never expose these to the browser; inject at deploy / CI time only.
STAGING_SUPABASE_SERVICE_ROLE_KEY=<service role key for the staging project>
PREVIEW_SUPABASE_SERVICE_ROLE_KEY=<service role key for the preview project>
PRODUCTION_SUPABASE_SERVICE_ROLE_KEY=<service role key for the production project>

SUPABASE_URL=<ci/integration project url>
SUPABASE_PUBLISHABLE_KEY=<ci publishable key>
SUPABASE_SERVICE_ROLE_KEY=<ci service role key>
SMOKE_DEMO_EMAIL=<optional demo user for smoke suites>
SMOKE_DEMO_PASSWORD=<optional demo password>

CLOUDFLARE_API_TOKEN=<API token with Workers Scripts:Edit>
CLOUDFLARE_ACCOUNT_ID=<32-character account id>
LOVABLE_API_KEY=<gateway key>
ALERT_WEBHOOK_URL=<https://hooks.example.com/...>
