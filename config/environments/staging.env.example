# Staging environment — non-secret configuration only.
# Values live in GitHub Environment "staging" as Variables.
# Secrets (service role, Cloudflare, AI) live in GitHub Secrets — never in git.

APP_ENV=staging

VITE_SUPABASE_URL=https://your-staging-project.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=sb_publishable_staging_xxxxxxxx
VITE_SUPABASE_PROJECT_ID=your-staging-project-ref
SUPABASE_URL=https://your-staging-project.supabase.co
SUPABASE_PUBLISHABLE_KEY=sb_publishable_staging_xxxxxxxx

# Secrets (set in GitHub → Environments → staging → Secrets):
# SUPABASE_SERVICE_ROLE_KEY / STAGING_SUPABASE_SERVICE_ROLE_KEY
# CLOUDFLARE_API_TOKEN
# CLOUDFLARE_ACCOUNT_ID
# LOVABLE_API_KEY

# Workflow: .github/workflows/staging-deploy.yml
