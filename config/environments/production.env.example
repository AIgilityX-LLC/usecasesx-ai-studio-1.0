# Production environment — non-secret configuration only.
# Values live in GitHub Environment "production" as Variables.
# ALL privileged keys are GitHub Secrets with required reviewers.
# NEVER commit production secrets. NEVER reuse staging keys in production.

APP_ENV=production

VITE_SUPABASE_URL=https://your-production-project.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=sb_publishable_prod_xxxxxxxx
VITE_SUPABASE_PROJECT_ID=your-production-project-ref
SUPABASE_URL=https://your-production-project.supabase.co
SUPABASE_PUBLISHABLE_KEY=sb_publishable_prod_xxxxxxxx

# GitHub Environment "production" must require reviewers before deploy jobs run.
# Secrets (Environment secrets only):
# PRODUCTION_SUPABASE_SERVICE_ROLE_KEY
# CLOUDFLARE_API_TOKEN
# CLOUDFLARE_ACCOUNT_ID
# LOVABLE_API_KEY

# Deploy requires explicit authorization:
#   workflow_dispatch confirm == "deploy-production"
#   + environment approval
# See docs/cicd/production-authorization.md
# Workflow: .github/workflows/production-deploy.yml
