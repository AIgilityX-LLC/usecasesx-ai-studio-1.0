# Browser + SSR publishable values (safe to commit — protected by RLS, not secrecy).
# Lovable's build reads VITE_* from this committed .env at build time.

SUPABASE_PROJECT_ID="your-supabase-project-ref"
SUPABASE_URL="https://your-supabase-project-ref.supabase.co"
SUPABASE_PUBLISHABLE_KEY="your-anon-or-publishable-key"

VITE_SUPABASE_PROJECT_ID="your-supabase-project-ref"
VITE_SUPABASE_URL="https://your-supabase-project-ref.supabase.co"
VITE_SUPABASE_PUBLISHABLE_KEY="your-anon-or-publishable-key"

# Enterprise navigation v2 (sectioned sidebar + command palette). OFF by default.
# Set to "true" on staging/canary after classic smoke passes. Rollback: omit or "false".
# VITE_ENTERPRISE_NAVIGATION_V2_ENABLED=true

# Do NOT put SUPABASE_SERVICE_ROLE_KEY in committed .env.
#
# Local: create untracked `.env.local` with:
#   SUPABASE_SERVICE_ROLE_KEY="your-service-role-key"
#
# Lovable Cloud Secrets: the SUPABASE_ prefix is reserved, so add instead:
#   Name:  DB_SERVICE_ROLE_KEY
#   Value: your project's service_role key (Supabase Dashboard → API)

